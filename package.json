{
  "name": "@vidit19sharma/opencode-kiro-auth",
  "version": "0.1.0",
  "description": "OpenCode plugin that uses your Kiro subscription through the official kiro-cli (ACP) — no token scraping, no private API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-kiro-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "installation.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "Vidit Sharma <vidit19sharma@gmail.com> (https://github.com/vidit19sharma)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidit19sharma/opencode-kiro-auth.git"
  },
  "bugs": {
    "url": "https://github.com/vidit19sharma/opencode-kiro-auth/issues"
  },
  "homepage": "https://github.com/vidit19sharma/opencode-kiro-auth#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kiro",
    "kiro-cli",
    "acp",
    "aws",
    "ai",
    "llm"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "bash scripts/test-offline.sh",
    "test:package": "bun scripts/package-host.ts",
    "test:live": "bun scripts/live-smoke.ts",
    "test:cli": "bash spike/cli-setup.test.sh",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "opencode-ai": "1.19.1",
    "typescript": "^5.7.0",
    "zod": "4.1.8"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
